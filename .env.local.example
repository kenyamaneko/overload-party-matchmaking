APP_ENV=local
PORT=8080
# ローカル専用: DB 0 をサーバ用、DB 1 をテスト用 (Makefile) に分離する。
# テストの FLUSHDB がサーバのキューを破壊しないようにするため。
# 本番 Upstash は論理 DB を 1 つしか持たないので /0 指定は付けない。
UPSTASH_REDIS_URL=redis://localhost:6379/0
GOOGLE_CLOUD_PROJECT_ID=local-project
PUBSUB_TOPIC=matchmaking-events
PUBSUB_EMULATOR_HOST=localhost:8085
MATCHMAKING_CIRCUIT_THRESHOLD=5
MATCHMAKING_CIRCUIT_COOLDOWN_SEC=30
MATCHMAKING_DRAIN_TIMEOUT_SEC=10
